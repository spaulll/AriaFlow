# AriaFlow — bot image.
# Builds the ariaflow binary, then wraps it in a runtime image with the
# tools it shells out to (yt-dlp, ffmpeg, archive extractors).

# syntax=docker/dockerfile:1
FROM golang:1.24 AS build
# Optional override: docker build --build-arg VERSION=v0.11.3
# When omitted, the version baked into the source (internal/version) is
# used, so no environment is required to get a correct version string.
ARG VERSION
WORKDIR /src

# Vendored deps -> no network needed during build.
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal
COPY i18n ./i18n
COPY model ./model
COPY tool ./tool

RUN V=""; if [ -n "$VERSION" ]; then V="-X ariaflow/internal/version.Version=${VERSION}"; fi && \
    CGO_ENABLED=0 go build -mod=vendor -trimpath \
      -ldflags "-s -w $V" \
      -o /out/ariaflow ./cmd/DownloadBot

FROM debian:bookworm-slim AS runtime

ARG TARGETARCH

# Runtime tools the bot shells out to.
RUN if grep -q '^Components:' /etc/apt/sources.list.d/debian.sources 2>/dev/null; then \
      sed -i 's/^Components:.*/Components: main contrib non-free/' /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         ca-certificates curl ffmpeg unzip p7zip-full python3 \
    && apt-get install -y --no-install-recommends unrar \
    && rm -rf /var/lib/apt/lists/* \
    && ASSET="yt-dlp_linux" \
    && [ "$TARGETARCH" = "arm64" ] && ASSET="yt-dlp_linux_aarch64"; \
    curl -fSL "https://github.com/yt-dlp/yt-dlp/releases/latest/download/$ASSET" \
      -o /usr/local/bin/yt-dlp \
    && chmod +x /usr/local/bin/yt-dlp

COPY --from=build /out/ariaflow /app/ariaflow
COPY docker/entrypoint.sh docker/render_config.py /app/
RUN chmod +x /app/entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
