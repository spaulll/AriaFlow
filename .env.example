# Copy to .env and fill in. Never commit .env (it contains secrets).

# ---- Required ---------------------------------------------------------------
# aria2 RPC secret (use a long random string). Must match between the aria2 and
# bot services — it is shared via this single variable.
ARIA2_SECRET=change-me-to-a-long-random-secret

# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:AA-your-bot-token

# Your numeric Telegram user id (the bot admin). Get it from @userinfobot.
ADMIN_ID=123456789

# ---- Optional: self-hosted Bot API server (forwarded files up to 2 GB) ------
# To use the local API server, set API_ID + API_HASH (my.telegram.org →
# "API development tools") and start with the api-server profile:
#   docker compose --profile api-server up -d
# Leave these blank (default) to use Telegram's cloud API (20 MB file cap).
API_ID=
API_HASH=
API_BASE=http://tg-bot-api:8081
API_DIR=/data/.tg-bot-api

# ---- Optional: paths / behaviour --------------------------------------------
# Download directory and media library root (shared volume). If you mount a NAS
# bind volume, point these at it.
DOWNLOAD_DIR=/data/downloads
LIBRARY_ROOT=/data

# Post-download organizing.
ORGANIZE_ENABLED=true
ANILIST=true
DELETE_ARCHIVE=false
KEEP_TORRENT=true

# yt-dlp.
YTDLP_PATH=yt-dlp
YTDLP_QUALITY=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
YTDLP_EMBED=true
YTDLP_COOKIES=
YTDLP_PROXY=

# Misc / logging.
MAX_INDEX=10
LANGUAGE=en
LOG_LEVEL=info

# Optional: expose aria2 RPC to the host (not needed for normal operation).
ARIA2_RPC_PORT=6800
